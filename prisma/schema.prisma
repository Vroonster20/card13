generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isGuest       Boolean         @default(false)
  accounts      Account[]
  gamePlayers   GamePlayer[]
  hostedGames   Game[]          @relation("GameHost")
  lobbyPlayers  LobbyPlayer[]
  matchHistory  MatchHistory[]
  sessions      Session[]
  statistics    UserStatistics?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lobby {
  id         String        @id @default(cuid())
  code       String        @unique
  hostId     String
  status     LobbyStatus   @default(WAITING)
  maxPlayers Int           @default(7)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  game       Game?
  players    LobbyPlayer[]

  @@map("lobbies")
}

model LobbyPlayer {
  id        String   @id @default(cuid())
  lobbyId   String
  userId    String
  isReady   Boolean  @default(false)
  seatIndex Int      @default(0)
  joinedAt  DateTime @default(now())
  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@unique([lobbyId, seatIndex])
  @@map("lobby_players")
}

model Game {
  id                String         @id @default(cuid())
  lobbyId           String         @unique
  hostId            String
  status            GameStatus     @default(IN_PROGRESS)
  currentRound      Int            @default(1)
  currentTurnUserId String?
  drawPile          Json           @default("[]")
  discardPile       Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  endedAt           DateTime?
  players           GamePlayer[]
  host              User           @relation("GameHost", fields: [hostId], references: [id])
  lobby             Lobby          @relation(fields: [lobbyId], references: [id])
  matchHistory      MatchHistory[]
  rounds            Round[]

  @@map("games")
}

model GamePlayer {
  id             String       @id @default(cuid())
  gameId         String
  userId         String
  seatIndex      Int
  hand           Json         @default("[]")
  isConnected    Boolean      @default(true)
  disconnectedAt DateTime?
  finalScore     Int?
  finalRank      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundScores    RoundScore[]

  @@unique([gameId, userId])
  @@unique([gameId, seatIndex])
  @@map("game_players")
}

model Round {
  id          String       @id @default(cuid())
  gameId      String
  roundNumber Int
  wildRank    String
  cardsDealt  Int
  status      RoundStatus  @default(IN_PROGRESS)
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  scores      RoundScore[]
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
  @@map("rounds")
}

model RoundScore {
  id           String     @id @default(cuid())
  roundId      String
  gamePlayerId String
  rawScore     Int
  bonus        Int        @default(0)
  totalScore   Int
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  round        Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, gamePlayerId])
  @@map("round_scores")
}

model UserStatistics {
  id             String   @id @default(cuid())
  userId         String   @unique
  gamesPlayed    Int      @default(0)
  gamesWon       Int      @default(0)
  totalScore     Int      @default(0)
  lowestScore    Int?
  highestScore   Int?
  bestRoundScore Int?
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_statistics")
}

model MatchHistory {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  playerCount Int
  finalScore  Int
  finalRank   Int
  rounds      Json     @default("[]")
  playedAt    DateTime @default(now())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("match_history")
}

enum LobbyStatus {
  WAITING
  STARTING
  IN_GAME
  CLOSED
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
}
